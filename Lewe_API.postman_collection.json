		{
			"name": "Matching",
			"item": [
				{
					"name": "Find Matches for Item (User A)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    var json = pm.response.json();",
									"    if (json.matches && json.matches.length > 0) {",
									"        pm.collectionVariables.set('match_id', json.matches[0].id);",
									"        pm.test('Matches found', function() {",
									"            pm.expect(json.count).to.be.above(0);",
									"        });",
									"    }",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{access_token}}"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/v1/items/{{item_id}}/matches",
							"host": ["{{base_url}}"],
							"path": ["api", "v1", "items", "{{item_id}}", "matches"]
						},
						"description": "Discover and create matches for User A's item. If User B's item exists with bidirectional want overlap, a match will be created. Match ID is auto-saved."
					},
					"response": []
				},
