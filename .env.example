# Copy to .env and adjust. .env is git-ignored.
DATABASE_URL=postgres://lewe:lewe@localhost:5432/lewe?sslmode=disable
# Use a long random value, e.g. `openssl rand -hex 32`
JWT_SECRET=change-me-to-a-long-random-secret-of-32-chars
PORT=:8080
# How often the matching worker scans for new swaps (it also runs right after
# items or wants are created/updated).
MATCH_INTERVAL=1m
# Login/register/refresh/logout requests allowed per client IP per minute (0 = off)
AUTH_RATE_LIMIT=20
# Set to true only behind a reverse proxy that sets X-Forwarded-For
TRUST_PROXY=false
# Comma-separated browser origins allowed to call the API, or * for any
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Client app base URL; emailed links go to {APP_URL}/verify-email and {APP_URL}/reset-password
APP_URL=http://localhost:3000
# Leave SMTP_HOST empty in development: emails (with their links) are printed to the log
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=Lewe <no-reply@example.com>
